{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    "types": [
      "jest"
    ],
    "paths": {
      "theme/*": [
        "./src/theme/*"
      ],
      "components/*": [
        "./src/components/*"
      ],
      "features/*": [
        "./src/features/*"
      ],
      "services/*": [
        "./src/services/*"
      ],
      "query/*": [
        "./src/query/*"
      ],
      "store/*": [
        "./src/store/*"
      ],
      "models/*": [
        "./src/models/*"
      ],
      "hooks/*": [
        "./src/hooks/*"
      ],
      "utils/*": [
        "./src/utils/*"
      ],
      "test/*": [
        "./src/test/*"
      ]
    }
  },
  "include": [
    "**/*.ts",
    "**/*.tsx",
    ".expo/types/**/*.ts",
    "expo-env.d.ts"
  ]
}
